{
  "db_name": "PostgreSQL",
  "query": "SELECT c.id, c.couple_name, c.anniversary_date, c.created_at, u1.nickname as user1_nickname, u2.nickname as \"user2_nickname?\", pc.code as \"pairing_code?\" FROM couples c JOIN users u1 ON c.user1_id = u1.id LEFT JOIN users u2 ON c.user2_id = u2.id LEFT JOIN pairing_codes pc ON c.id = pc.couple_id  AND pc.used_at IS NULL  AND pc.expires_at > NOW() WHERE c.user1_id = $1 OR c.user2_id = $1",
