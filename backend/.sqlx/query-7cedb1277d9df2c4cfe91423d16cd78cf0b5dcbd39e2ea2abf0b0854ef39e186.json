{
  "db_name": "PostgreSQL",
  "query": "SELECT pc.id, pc.couple_id, pc.created_by, c.user1_id, c.user2_id, c.couple_name, c.anniversary_date, c.created_at, u.nickname as user1_nickname\n             FROM pairing_codes pc\n             JOIN couples c ON pc.couple_id = c.id\n             JOIN users u ON c.user1_id = u.id\n             WHERE pc.code = $1 \n             AND pc.expires_at > NOW() \n             AND pc.used_at IS NULL",
