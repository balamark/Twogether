  "query": "SELECT c.id, c.couple_name, c.anniversary_date, c.created_at,\n                    u1.nickname as user1_nickname, u2.nickname as user2_nickname\n             FROM couples c\n             JOIN users u1 ON c.user1_id = u1.id\n             JOIN users u2 ON c.user2_id = u2.id\n             WHERE c.id = $1",
