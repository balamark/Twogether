{
  "name": "twogether",
  "version": "1.0.0",
  "description": "Twogether - Couples Relationship Tracking App (Combined Frontend + Backend)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite --port 5174",
    "dev:backend": "NODE_ENV=development nodemon server.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5174",
    "test": "npm run test:backend && npm run test:e2e",
    "test:backend": "NODE_ENV=test DISABLE_RATE_LIMIT=true node test-integration.js",
    "test:ci": "node scripts/test-ci.js",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "lint": "eslint .",
    "migrate": "node scripts/migrate.js migrate",
    "migrate:status": "node scripts/migrate.js status"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "react": "^19.1.0",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "sharp": "^0.33.0",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.48.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "chai": "^4.3.10",
    "concurrently": "^9.2.1",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0"
  },
  "keywords": [
    "couples",
    "relationship",
    "love",
    "moments",
    "twogether",
    "react",
    "nodejs"
  ],
  "author": "Twogether Team",
  "license": "MIT"
}
