# Twogether Environment Configuration — template
# Copy this file to .env and fill in real values. NEVER commit .env.
# In production, set these via GitHub Actions secrets + App Engine env vars.

# --- Server ---
PORT=8080
# Allowed browser origin in dev/test (Vite frontend on :5174).
CORS_ORIGIN=http://localhost:5174

# --- Database ---
# Supabase pooler URL — used directly by the `pg` client (database/db.js).
# Get it from Supabase Dashboard → Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.<your-project-ref>:<your-password>@<host>:5432/postgres

# --- Auth ---
# HMAC secret for signing app JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# express-session cookie secret.
SESSION_SECRET=change-me-to-a-different-long-random-string

# --- Supabase Storage (photo + thumbnail uploads, lib/supabase-storage.js) ---
# Get URL + Secret API key from Supabase Dashboard → Settings → API Keys.
# Use the new "Secret" API key (the legacy service_role JWT is deprecated).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-api-key

# --- Email (services/emailService.js — nodemailer over Gmail SMTP) ---
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-gmail-app-password
# Only takes effect if literally "true" (implicit TLS, port 465). For Gmail
# STARTTLS on 587 leave anything else — "starttls" is fine as a label.
SMTP_SECURE=starttls

# --- Frontend links in outgoing emails ---
# Optional. If unset, emailService.js falls back to the deployed prod URL.
# Set this for local testing so dev-sent emails don't point at production.
# FRONTEND_URL=http://localhost:5174
