# Twogether Environment Configuration
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# Server Configuration
PORT=8080
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5174

# Database Configuration
# Supabase PostgreSQL Database (REQUIRED)
# Get this from your Supabase project: Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.gqhoebnveeaishflmkqv:your-supabase-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# JWT Configuration - CHANGE THIS SECRET!
JWT_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-IN-PRODUCTION
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# Environment
ENVIRONMENT=development

# Google Cloud Configuration (for production)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1

# Supabase Configuration (REQUIRED - get these from your Supabase project)
# 1. Go to https://supabase.com and create a project
# 2. Go to Settings > API to find these values
# 3. NEVER share these keys publicly!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Security Notes:
# - Change all default passwords and secrets before using
# - SUPABASE_SERVICE_ROLE_KEY has admin access - keep it secret!
# - Never commit .env file to version control
# - Use strong, unique passwords for production
# - DATABASE_URL should point to your Supabase PostgreSQL instance 