# Twogether Environment Configuration — template
# Copy this file to .env and fill in real values. NEVER commit .env.
# In production, set these via GitHub Actions secrets + App Engine env vars.

# --- Server ---
PORT=8080
# Allowed browser origin in dev/test (Vite frontend on :5174).
CORS_ORIGIN=http://localhost:5174

# --- Database ---
# Supabase pooler URL — used directly by the `pg` client (database/db.js).
# Get it from Supabase Dashboard → Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.<your-project-ref>:<your-password>@<host>:5432/postgres

# --- Auth ---
# HMAC secret for signing app JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# express-session cookie secret.
SESSION_SECRET=change-me-to-a-different-long-random-string
# Session lifetime — applies to both the issued JWT (Authorization: Bearer …)
# and the express-session cookie (server.js keeps these in sync). Format:
# <number><unit> where unit is s/m/h/d. Examples: "24h", "7d", "30m".
# After this elapses, the client receives 403 TOKEN_EXPIRED on the next call
# and is redirected to the login screen.
JWT_EXPIRES_IN=7d

# --- Supabase Storage (photo + thumbnail uploads, lib/supabase-storage.js) ---
# Get URL + Secret API key from Supabase Dashboard → Settings → API Keys.
# Use the new "Secret" API key (the legacy service_role JWT is deprecated).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-api-key

# --- Email (services/emailService.js — nodemailer over SMTP) ---
# Production sends through Resend so mail is DKIM-signed for twogether.fun.
# Sending from a personal Gmail while every link points at twogether.fun is
# what put pairing invites in people's spam folders — the From: domain and the
# link domain have to match. Full DNS setup: docs/EMAIL_DELIVERABILITY.md
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
# For Resend this is the literal string "resend", not an email address.
SMTP_USER=resend
# For Resend this is an API key (re_...). For Gmail it'd be an App Password:
# https://myaccount.google.com/apppasswords
SMTP_PASS=your-resend-api-key
# Only takes effect if literally "true" (implicit TLS, port 465). For STARTTLS
# on 587 leave anything else — "starttls" is fine as a label.
SMTP_SECURE=starttls

# The From: address on every outgoing mail. Accepts "addr@host" or
# "Name <addr@host>"; the display name is set per-email-type in code either
# way. MUST be on a domain you've verified with your provider (Resend →
# Domains → Add Domain), otherwise the mail is unsigned and lands in spam.
# Unset → falls back to SMTP_USER, which is the old Gmail behaviour.
EMAIL_FROM=Twogether <hello@twogether.fun>
# Optional. Where replies land. Pairing invites override this with the
# inviter's own address so the partner can just hit reply.
EMAIL_REPLY_TO=support@twogether.fun

# --- Frontend links in outgoing emails ---
# Optional. If unset, emailService.js falls back to the deployed prod URL.
# Set this for local testing so dev-sent emails don't point at production.
# FRONTEND_URL=http://localhost:5174

# --- Payments: ECPay (綠界) premium passes (routes/billing.js, lib/ecpay.js) ---
# Premium is sold as one-time time-boxed passes. Without these set, the code
# falls back to ECPay's published STAGE test credentials (safe for dev/staging).
# For production set your own and ECPAY_MODE=production.
ECPAY_MODE=stage
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS

# --- Payments: 藍新金流 NewebPay (routes/billing.js, lib/newebpay.js) ---
# Second gateway offered alongside ECPay (信用卡 / ATM / 超商). Unlike ECPay there
# are NO universal published test credentials, so NewebPay checkout is DISABLED
# until all three are set — the UI offers it but the server returns an actionable
# "暫時無法使用，請改用綠界" message. Get these from the NewebPay merchant portal
# (商店資料 → 私鑰資訊: HashKey 32 chars, HashIV 16 chars). Set NEWEBPAY_MODE=production
# with your live store to go live.
NEWEBPAY_MODE=stage
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=

# Externally-reachable origin so the gateways can reach the server-to-server
# callback (ReturnURL / NotifyURL) and redirect the browser back.
# e.g. https://your-app.appspot.com
APP_BASE_URL=http://localhost:8080

# --- Freemium caps (lib/entitlements.js) — optional overrides ---
# Free-tier defaults: icebreaker 5/day, 3 custom scripts, 30 photos.
# Premium AI/day defaults to 50. Raise/lower without code changes.
# EVENTS_AI_DAILY_LIMIT=5
# PREMIUM_AI_DAILY_LIMIT=50
# FREE_CUSTOM_SCRIPTS_LIMIT=3
# FREE_PHOTO_UPLOADS_LIMIT=30
