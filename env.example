# Twogether Environment Configuration
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5174

# Database Configuration
# Supabase PostgreSQL Database (REQUIRED)
# Get this from your Supabase project: Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.gqhoebnveeaishflmkqv:your-supabase-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# JWT Configuration - CHANGE THIS SECRET!
JWT_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-IN-PRODUCTION

# Session Configuration
SESSION_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-FOR-SESSIONS

# Supabase Configuration (REQUIRED - get these from your Supabase project)
# 1. Go to https://supabase.com and create a project
# 2. Go to Settings > API to find these values
# 3. NEVER share these keys publicly!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Email (Resend)
# Sign up at https://resend.com and get an API key
RESEND_API_KEY=re_gcJXdCHm_4GA8ypPK4ub6vrG9K2PzZnZh
# Verified sender address, e.g. "Twogether <no-reply@yourdomain.com>"
EMAIL_FROM=Twogether <no-reply@twogether.com>

# Email (SMTP alternative)
# Use this to send via your mailbox (e.g., Gmail/Outlook) without a custom domain
# For Gmail, create an App Password and use smtp.gmail.com:587
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your-app-password

# Security Notes:
# - Change all default passwords and secrets before using
# - SUPABASE_SERVICE_ROLE_KEY has admin access - keep it secret!
# - Never commit .env file to version control
# - Use strong, unique passwords for production
# - DATABASE_URL should point to your Supabase PostgreSQL instance 